# ── PayPal Sandbox (developer.paypal.com → Apps & Credentials → Sandbox tab) ──
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# Sandbox personal account that receives test payouts.
# Find it at developer.paypal.com → Testing Tools → Sandbox Accounts
# (looks like sb-xxxxx@personal.example.com — NOT a secret, safe to share)
PAYPAL_PAYOUT_RECEIVER=

# OPTIONAL: dedicated sandbox app for payouts, needed only if you hit
# "PAYOUT_NOT_AVAILABLE — country not allowed to send this payout" (sender-country
# sandbox restriction, e.g. India-based developer). Create a US-country sandbox
# Business account + a new app linked to it, and put that app's keys here.
# Checkout keeps using the credentials above.
PAYPAL_PAYOUT_CLIENT_ID=
PAYPAL_PAYOUT_CLIENT_SECRET=

# ── OpenRouter (openrouter.ai/keys) ──
OPENROUTER_API_KEY=sk-or-v1-...
# Free vision-capable model used for checklist generation + proof evaluation.
# Re-verify the free list at https://openrouter.ai/models if these ids change.
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_FALLBACKS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# ── App ──
# Any long random string, used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=change_me
